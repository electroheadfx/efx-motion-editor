+// SPIKE 004: a document-space value noise for the gravity PATCHES. It is a
+// pure function of the texel position (no time, no RNG), so live and bake can
+// never disagree; document-space means the drips form in fixed lanes, and the
+// noise travels with nothing, so a lane keeps its strength as paint sags
+// through it. uGravityNoise = 0 is inert (multiply by 1).
+const GRAVITY_NOISE = `
+uniform float uGravityNoise, uGravityNoiseScale;
+float gravHash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
+float gravNoise(vec2 uv){
+  vec2 p = uv * uGravityNoiseScale;
+  vec2 i = floor(p), f = fract(p);
+  vec2 u = f * f * (3.0 - 2.0 * f);
+  float a = gravHash(i), b = gravHash(i + vec2(1.0, 0.0));
+  float c = gravHash(i + vec2(0.0, 1.0)), d = gravHash(i + vec2(1.0, 1.0));
+  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
+}
+float gravPatch(vec2 uv){
+  return mix(1.0, smoothstep(0.30, 0.70, gravNoise(uv)), uGravityNoise);
+}
+`;
