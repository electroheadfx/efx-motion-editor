{
  "name": "@efxlab/efx-paint-host",
  "version": "0.1.0",
  "license": "GPL-2.0-only",
  "description": "Studio-law paint host: animation schedules, traceSeed determinism, and the generic StudioStroke contract (Preact-free)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efxlab/efx-motion-editor.git",
    "directory": "packages/efx-paint-host"
  },
  "author": "Laurent Marques <laurentefx@icloud.com>",
  "homepage": "https://github.com/efxlab/efx-motion-editor#readme",
  "bugs": {
    "url": "https://github.com/efxlab/efx-motion-editor/issues"
  },
  "keywords": [
    "animation",
    "schedule",
    "determinism",
    "paint",
    "studio"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./animation": {
      "types": "./dist/animation.d.ts",
      "import": "./dist/animation.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev:watch": "tsup --watch",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  }
}
