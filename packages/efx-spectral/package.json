{
  "name": "@efxlab/efx-spectral",
  "version": "0.1.0",
  "license": "GPL-2.0-only",
  "description": "Subtractive spectral pigment mixing (Kubelka-Munk method ported from rvanwijnen/spectral.js, MIT) — shared by engine 2 and, later, engine 1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efxlab/efx-motion-editor.git",
    "directory": "packages/efx-spectral"
  },
  "author": "Laurent Marques <laurentefx@icloud.com>",
  "homepage": "https://github.com/efxlab/efx-motion-editor#readme",
  "bugs": {
    "url": "https://github.com/efxlab/efx-motion-editor/issues"
  },
  "keywords": [
    "spectral",
    "pigment",
    "kubelka-munk",
    "color",
    "mixing",
    "watercolor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {},
  "scripts": {
    "build": "tsup",
    "dev:watch": "tsup --watch",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  }
}
