{
  "name": "@efxlab/efx-watercolor",
  "version": "0.1.0",
  "license": "GPL-2.0-only",
  "description": "Animatable watercolour engine 2 — spectral pigment, fluid deposit, Studio script law (Preact-free core)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efxlab/efx-motion-editor.git",
    "directory": "packages/efx-watercolor"
  },
